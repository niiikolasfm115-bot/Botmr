# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_admin_id_here

# Free Fire Server Configuration
FF_SERVER_IP=your_ff_server_ip
FF_SERVER_PORT=your_ff_server_port

# Database Configuration
DATABASE_URL=sqlite:///ff_bot.db

# Bot Configuration
REGION=PK
BOT_OWNER_UID=your_uid_here
WHITELIST_MODE=False

# Safety Configuration
COMMAND_DELAY=2.0
MESSAGE_DELAY=0.5
EMOTE_DELAY=1.0
RECONNECT_DELAY=5.0
MAX_REQUESTS_PER_MINUTE=30

# Security
ENCRYPTION_ENABLED=True
RATE_LIMIT_ENABLED=True
